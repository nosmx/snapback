# Snapback configuration. Copy to .env and fill in what you have.
# Every sponsor has a mock fallback: leave a block empty and that integration runs in mock mode.
# Per-integration mode: auto (real if credentials are present, else mock) | real | mock

# --- LLM (explains and ranks only; rules decide) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_MODE=auto

# --- Senso Context Layer (policies, warranties, review summaries; cited) ---
SENSO_API_KEY=
SENSO_BASE_URL=https://apiv2.senso.ai/api/v1
SENSO_MODE=auto

# --- Superlinked SIE Serverless (image embed, extract, rerank) ---
SIE_API_KEY=
SIE_BASE_URL=https://api.superlinked.com
SIE_IMAGE_EMBED_MODEL=google/siglip-so400m-patch14-384
SIE_TEXT_EMBED_MODEL=BAAI/bge-m3
SIE_EXTRACT_MODEL=fastino/gliner2-large-v1
SIE_RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# Must match the chosen embedding models (drives the VECTOR(n) columns)
IMAGE_EMBED_DIM=1152
TEXT_EMBED_DIM=1024
SIE_MODE=auto

# --- SingleStore (orders, catalog+vectors, tasks, approvals, audit_log) ---
# e.g. user:password@svc-xxxx.singlestore.com:3306/snapback  (paste the password as-is; no URL-encoding)
SINGLESTORE_URL=
# Falls back to SQLite at data/snapback.db. Decided at startup only.
DB_MODE=auto

# --- Persona (mandate verification, one-tap approvals) ---
PERSONA_API_KEY=
PERSONA_ENVIRONMENT_ID=
PERSONA_TEMPLATE_ID_MANDATE=
PERSONA_TEMPLATE_ID_APPROVAL=
PERSONA_MODE=auto

# --- Amplitude (step events) + Statsig (replacement_strategy flag) ---
AMPLITUDE_API_KEY=
AMPLITUDE_MODE=auto
STATSIG_SERVER_SECRET=
STATSIG_CLIENT_KEY=
STATSIG_MODE=auto

# --- App ---
BACKEND_PORT=8000
MERCHANT_PORT=8001
MERCHANT_BASE_URL=http://localhost:8001
BACKGROUND_LOOP_SECONDS=30
PHOTO_MATCH_THRESHOLD=0.80
PLAYWRIGHT_HEADLESS=false
# Seconds between a return/adjustment being filed and the mock bank posting the refund
REFUND_DELAY_SECONDS=3
# How long a flow waits for the refund before the background loop takes over the follow-up
AWAIT_REFUND_SECONDS=20
PLAYWRIGHT_SLOW_MO_MS=150
# Optional: run tests/scenarios through Firedrill when set
FIREDRILL_API_KEY=
